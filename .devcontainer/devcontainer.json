{
  "name": "Coderhouse - SQL Server 2022",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/coderhouse-data-analytics",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "postCreateCommand": "bash modulo_4/verificar.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-mssql.mssql"],
      "settings": {
        "mssql.connections": [
          {
            "profileName": "Ventas Tech - Codespaces",
            "server": "localhost,1433",
            "database": "Ventas_Tech_DB",
            "authenticationType": "SqlLogin",
            "user": "sa",
            "savePassword": false,
            "encrypt": "Mandatory",
            "trustServerCertificate": true
          }
        ]
      }
    }
  }
}
